rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /analytics/{docId} {
      allow read: if true;
      allow create: if request.resource.data.visitor_count is int && request.resource.data.visitor_count >= 1;
      allow update: if request.resource.data.visitor_count is int;
      allow delete: if false;
    }
  }
}
