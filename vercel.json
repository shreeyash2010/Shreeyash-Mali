{
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "mali-studios.vercel.app"
        }
      ],
      "destination": "https://mali-web-studios.vercel.app/",
      "statusCode": 301
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "mali-studios.vercel.app"
        }
      ],
      "destination": "https://mali-web-studios.vercel.app/$1",
      "statusCode": 301
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
}
